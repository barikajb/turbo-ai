# Copy to .env and change what you need. Every value here is the default.
# Real environment variables override this file.

# Ollama
TURBO_OLLAMA_URL=http://localhost:11434
# Fast model for plain questions
TURBO_CHAT_MODEL=llama3.2:3b
# Model for explain / fix (and follow-ups once code is in the conversation)
TURBO_CODE_MODEL=qwen2.5-coder:7b
# Seconds to wait for a reply (CPU-only machines are slow)
TURBO_TIMEOUT=300
# Model context window in tokens. Bigger = longer files, more RAM.
TURBO_CONTEXT_TOKENS=8192
# How much earlier conversation (characters) to send with each request
TURBO_HISTORY_CHARS=12000
# Conversation database (default: data/turbo.db in this folder)
# TURBO_DB_PATH=

# Server for the VS Code extension
TURBO_HOST=127.0.0.1
TURBO_PORT=8765
# Optional shared secret; also set "turbo.token" in VS Code settings
TURBO_TOKEN=
