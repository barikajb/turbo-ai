# Copy to ~/.turbo/.env (Windows: C:\Users\<you>\.turbo\.env) and change what you need.
# Every value here is the default. Real environment variables override this file.
# You can also switch models from the chat with /model, and /model ... --save
# writes the choice here for you.

# Ollama
TURBO_OLLAMA_URL=http://localhost:11434
# Fast model for plain questions
TURBO_CHAT_MODEL=llama3.2:3b
# Model for explain / fix (and follow-ups once code is in the conversation).
# qwen2.5-coder:7b finds bugs better but is about twice as slow on CPU.
TURBO_CODE_MODEL=qwen2.5-coder:3b
# Seconds to wait (for the first word, then between words)
TURBO_TIMEOUT=300

# Speed tuning
# Starting context window in tokens. It grows automatically for big files,
# up to TURBO_MAX_CONTEXT_TOKENS. Smaller = less RAM and faster on CPU.
TURBO_CONTEXT_TOKENS=4096
TURBO_MAX_CONTEXT_TOKENS=16384
# Max answer length (tokens) for questions and explanations. Fixes aren't capped.
TURBO_MAX_TOKENS=1200
# How long Ollama keeps the model in memory after a request (reloading takes ~10s)
TURBO_KEEP_ALIVE=30m
# Earlier conversation (characters) sent with each request. Less = faster.
TURBO_HISTORY_CHARS=6000

# Files
# Folder for history and this .env (default: ~/.turbo)
# TURBO_HOME=
# Conversation database (default: ~/.turbo/turbo.db)
# TURBO_DB_PATH=

# Server for the VS Code extension
TURBO_HOST=127.0.0.1
TURBO_PORT=8765
# Optional shared secret; also set "turbo.token" in VS Code settings
TURBO_TOKEN=
